# ─────────────────────────────────────────────────────────────────────────────
# Template de Secret — NE JAMAIS commiter avec des valeurs réelles
# Générer le vrai secret avec : bash scripts/k8s-secrets.sh
# Ou via un secret manager externe (Sealed Secrets, External Secrets Operator)
# ─────────────────────────────────────────────────────────────────────────────

apiVersion: v1
kind: Secret
metadata:
  name: rag-secrets
  namespace: rag-system
type: Opaque
stringData:
  POSTGRES_USER:     "raguser"
  POSTGRES_PASSWORD: "CHANGE-ME-IN-PRODUCTION"
  POSTGRES_DSN:      "postgresql+asyncpg://raguser:CHANGE-ME-IN-PRODUCTION@postgres:5432/ragdb"
  GRAFANA_USER:      "admin"
  GRAFANA_PASSWORD:  "CHANGE-ME-IN-PRODUCTION"
